---
// X2Post 宣发组件。
// - hero：首页顶部大横幅
// - banner：列表页、文章末尾的横向横幅（默认）
// - vertical：文章页目录下方的竖版卡片
interface Props {
	variant?: "hero" | "banner" | "vertical";
}

const { variant = "banner" } = Astro.props;

const X2POST_URL = "https://x2post.com";
const STORY_URL = "/posts/2026/08/23/";
---

{
	variant === "hero" && (
		<section
			aria-label="X2Post 社区"
			class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[oklch(36%_0.1_205)] via-[oklch(44%_0.12_205)] to-[oklch(53%_0.13_195)] p-6 text-white shadow-lg sm:p-8"
		>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.16)_1px,transparent_0)] opacity-60 [background-size:18px_18px]"
			/>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -top-16 -right-10 h-52 w-52 rounded-full bg-white/10 blur-3xl"
			/>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-black/10 blur-3xl"
			/>
			<div class="relative">
				<div class="flex flex-wrap items-center gap-3">
					<img
						src="/x2post.svg"
						alt="X2Post"
						class="h-14 w-14 shrink-0 rounded-xl shadow-sm ring-2 ring-white/40"
						width="56"
						height="56"
					/>
					<div class="flex flex-col gap-1">
						<span class="w-fit rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium text-white/90 ring-1 ring-white/25 ring-inset">
							我做的内容社区
						</span>
						<span class="text-xs font-medium tracking-wide text-white/70">
							x2post.com
						</span>
					</div>
				</div>

				<p class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
					X2Post
				</p>
				<p class="mt-2 text-base font-semibold sm:text-lg">
					让每一次表达，都成为值得被听见的回声
				</p>
				<p class="mt-1 max-w-xl text-sm leading-relaxed text-white/80">
					一个专注高质量经验分享与真诚讨论的社区。内容即资产，发布后不可编辑、不可删除；表达永远免费。
				</p>

				<div class="mt-4 flex flex-wrap gap-2">
					{["内容即资产", "表达永远免费"].map((item) => (
						<span class="rounded-full border border-white/25 bg-white/10 px-2.5 py-1 text-xs font-medium text-white/90">
							{item}
						</span>
					))}
				</div>

				<div class="mt-6 flex flex-wrap items-center gap-3">
					<a
						href={X2POST_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[#075e78] shadow-sm transition hover:bg-white/90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					>
						进入 X2Post
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</section>
	)
}

{
	variant === "banner" && (
		<section class="relative overflow-hidden rounded-xl bg-gradient-to-r from-[oklch(36%_0.1_205)] via-[oklch(44%_0.12_205)] to-[oklch(51%_0.12_195)] p-4 text-white shadow-md sm:p-5">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -top-14 -right-8 h-40 w-40 rounded-full bg-white/10 blur-3xl"
			/>
			<div class="relative flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
				<img
					src="/x2post.svg"
					alt="X2Post"
					class="h-11 w-11 shrink-0 rounded-xl ring-2 ring-white/40"
					width="44"
					height="44"
				/>
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-2">
						<p class="text-base font-bold">X2Post 社区</p>
						<span class="rounded-full bg-white/15 px-2 py-0.5 text-[10px] font-medium text-white/90 ring-1 ring-white/25 ring-inset">
							我做的产品
						</span>
					</div>
					<p class="mt-0.5 text-xs leading-relaxed text-white/85 sm:text-sm">
						认真分享 · 友善讨论，一个把内容当作长期资产的社区。
					</p>
				</div>
				<a
					href={X2POST_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex w-fit shrink-0 items-center gap-1.5 rounded-full bg-white px-4 py-2 text-xs font-semibold text-[#075e78] shadow-sm transition hover:bg-white/90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:text-sm"
				>
					去社区看看
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	)
}

{
	variant === "vertical" && (
		<aside class="relative overflow-hidden rounded-xl bg-gradient-to-br from-[oklch(36%_0.1_205)] via-[oklch(44%_0.12_205)] to-[oklch(52%_0.13_195)] p-4 text-white shadow-md">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -top-12 -right-8 h-32 w-32 rounded-full bg-white/10 blur-3xl"
			/>
			<div class="relative flex flex-col">
				<div class="flex items-center gap-2.5">
					<img
						src="/x2post.svg"
						alt="X2Post"
						class="h-10 w-10 shrink-0 rounded-lg ring-2 ring-white/40"
						width="40"
						height="40"
					/>
					<div>
						<p class="text-sm font-bold leading-tight">X2Post 社区</p>
						<p class="text-[11px] text-white/75">我做的内容社区</p>
					</div>
				</div>
				<p class="mt-3 text-xs font-semibold">
					认真分享 · 友善讨论
				</p>
				<p class="mt-1 text-[11px] leading-relaxed text-white/80">
					内容即资产，表达永远免费。
				</p>
				<a
					href={X2POST_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-3 inline-flex w-full items-center justify-center gap-1 rounded-full bg-white px-3 py-2 text-xs font-semibold text-[#075e78] shadow-sm transition hover:bg-white/90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				>
					进入社区
					<span aria-hidden="true">→</span>
				</a>
				<a
					href={STORY_URL}
					class="mt-2 text-center text-[11px] text-white/75 underline-offset-2 transition hover:text-white hover:underline focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				>
					了解 X2Post 背后的故事
				</a>
			</div>
		</aside>
	)
}
