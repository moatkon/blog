---
import type { MonthlyStats } from "@/data/post";

export interface Props {
	data: MonthlyStats[];
	title?: string;
}

const { data, title = "Monthly Posts" } = Astro.props;

const MONTHS = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec",
];

const years = [...new Set(data.map((d) => d.year))]
	.sort((a, b) => b - a)
	.slice(0, 4);

const series = years.map((year) => {
	const counts = Array.from({ length: 12 }, () => 0);
	for (const item of data) {
		if (item.year === year) {
			counts[item.month] = (counts[item.month] ?? 0) + item.count;
		}
	}
	return {
		year,
		counts,
		max: Math.max(1, ...counts),
		total: counts.reduce((sum, count) => sum + count, 0),
	};
});

const initial = series[0];
---

<div
	class="rounded-lg border border-gray-200 bg-white p-4 sm:p-6 dark:border-zinc-700 dark:bg-zinc-800"
	data-monthly-chart
>
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
			{title}
		</h3>
		{
			series.length > 1 && (
				<div
					class="seg"
					role="tablist"
					aria-label="选择年份"
					style={`--n:${series.length}`}
				>
					<span class="seg__thumb" aria-hidden="true" />
					{series.map((item, index) => (
						<button
							class="seg__btn"
							type="button"
							role="tab"
							aria-selected={index === 0}
							aria-controls="monthly-chart-panel"
							data-counts={item.counts.join(",")}
							data-index={index}
							data-year={item.year}
						>
							{item.year}
						</button>
					))}
				</div>
			)
		}
	</div>

	{
		initial ? (
			<div
				class="space-y-4"
				id="monthly-chart-panel"
				role={series.length > 1 ? "tabpanel" : undefined}
				aria-label={series.length > 1 ? title : undefined}
			>
				<div class="relative flex h-[150px] items-end justify-between gap-1 pt-5">
					{initial.counts.map((count, index) => {
						const height = count > 0
							? Math.max(Math.round((count / initial.max) * 128), 5)
							: 2;
						return (
							<div class="flex h-full flex-1 flex-col items-center justify-end">
								<span
									class="chart-count mb-1 text-xs font-medium text-gray-700 dark:text-gray-300"
									data-count={index}
								>
									{count > 0 ? count : ""}
								</span>
								<div
									class:list={[
										"chart-bar w-full rounded-t",
										{ "is-peak": count === initial.max && count > 0 },
									]}
									data-bar={index}
									data-month={MONTHS[index]}
									style={`height:${height}px`}
									title={`${MONTHS[index]} ${initial.year}: ${count} posts`}
								/>
							</div>
						);
					})}
				</div>

				<div class="flex justify-between text-xs text-gray-600 dark:text-gray-400">
					{MONTHS.map((month) => (
						<span class="flex-1 text-center">{month}</span>
					))}
				</div>
			</div>
		) : (
			<div class="py-8 text-center text-gray-500 dark:text-gray-400">
				<p>No data available</p>
			</div>
		)
	}
</div>

<style>
	/*
	 * Motion Prompt #060 · MIT License (c) 2026 Shohei Ohtaki
	 * https://showheyohtaki.github.io/motion-prompt/#060
	 * 分段控件：高亮块 0.25s easeInOutCubic 滑动，图表同步变化
	 */
	.seg {
		position: relative;
		display: flex;
		padding: 4px;
		border-radius: 10px;
		background: color-mix(in srgb, var(--color-global-text) 8%, transparent);
	}

	.seg__thumb {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc((100% - 8px) / var(--n));
		border-radius: 8px;
		background: var(--color-accent);
		box-shadow: 0 2px 6px rgb(0 0 0 / 18%);
		transition: transform 0.25s var(--ease-in-out-cubic);
	}

	.seg__btn {
		position: relative;
		z-index: 1;
		flex: 1 1 0;
		min-width: 3.25rem;
		padding: 0.375rem 0.75rem;
		border-radius: 8px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: color-mix(in srgb, var(--color-global-text) 62%, transparent);
		transition: color 0.25s var(--ease-in-out-cubic);
		cursor: pointer;
	}

	.seg__btn[aria-selected="true"] {
		color: #fff;
	}

	.seg__btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.chart-bar {
		min-height: 2px;
		background: color-mix(in oklch, var(--color-accent) 32%, transparent);
		transition:
			height 0.25s var(--ease-in-out-cubic),
			background-color 0.25s var(--ease-in-out-cubic);
	}

	.chart-bar.is-peak {
		background: var(--color-accent);
	}

	.chart-bar:hover {
		opacity: 0.8;
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>(
		"[data-monthly-chart]",
	)) {
		const tabs = [
			...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
		];
		const bars = [...root.querySelectorAll<HTMLElement>("[data-bar]")];
		const counts = [
			...root.querySelectorAll<HTMLElement>("[data-count]"),
		];
		const thumb = root.querySelector<HTMLElement>(".seg__thumb");
		if (tabs.length === 0) continue;

		const select = (index: number) => {
			const tab = tabs[index];
			if (!tab) return;
			const values = (tab.dataset.counts ?? "")
				.split(",")
				.map((value) => Number(value) || 0);
			const max = Math.max(1, ...values);

			tabs.forEach((item, i) => {
				item.setAttribute("aria-selected", String(i === index));
			});

			bars.forEach((bar, i) => {
				const count = values[i] ?? 0;
				const height =
					count > 0 ? Math.max(Math.round((count / max) * 128), 5) : 2;
				bar.style.height = `${height}px`;
				bar.classList.toggle("is-peak", count === max && count > 0);
				const month = bar.dataset.month ?? "";
				bar.title = `${month} ${tab.dataset.year ?? ""}: ${count} posts`;
			});

			counts.forEach((label, i) => {
				const count = values[i] ?? 0;
				label.textContent = count > 0 ? String(count) : "";
			});

			if (thumb) {
				thumb.style.transform = `translateX(${index * 100}%)`;
			}
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(index));
			tab.addEventListener("keydown", (event) => {
				let next = index;
				if (event.key === "ArrowRight") {
					next = (index + 1) % tabs.length;
				} else if (event.key === "ArrowLeft") {
					next = (index - 1 + tabs.length) % tabs.length;
				} else if (event.key === "Home") {
					next = 0;
				} else if (event.key === "End") {
					next = tabs.length - 1;
				} else {
					return;
				}
				event.preventDefault();
				const nextTab = tabs[next];
				if (!nextTab) return;
				nextTab.focus();
				select(next);
			});
		});
	}
</script>
